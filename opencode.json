{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ava-v0",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "*": "deny",
    "bash": {
      "*": "ask",
      "virtuoso-bridge status": "allow"
    },
    "skill": {
      "*": "deny",
      "virtuoso": "allow",
      "spectre": "allow",
      "netlist": "allow",
      "optimizer": "allow"
    },
    "read": {
      "*": "ask",
      ".env": "deny",
      "*/.env": "deny",
      "AGENTS.md": "allow",
      "README.md": "allow",
      "opencode.json": "allow",
      ".opencode/agents/*": "allow",
      ".opencode/skills/*": "allow",
      ".opencode/skills/**/*": "allow",
      "vendor/bridge-provenance.json": "allow",
      "vendor/virtuoso-bridge-lite/*": "allow",
      "vendor/virtuoso-bridge-lite/**/*": "allow",
      "config/bridge.env.template": "allow",
      "offline/bundle-manifest.json": "allow",
      "offline/SHA256SUMS": "allow",
      "work/*": "allow",
      "work/**/*": "allow",
      "artifacts/*": "allow",
      "artifacts/**/*": "allow"
    },
    "edit": {
      "*": "ask",
      ".env": "deny",
      "*/.env": "deny",
      ".opencode/*": "deny",
      ".opencode/**/*": "deny",
      "vendor/*": "deny",
      "vendor/**/*": "deny",
      "opencode.json": "deny"
    },
    "question": "allow",
    "doom_loop": "ask"
  }
}
